      "type": "string"
    },
    "hoverAnimation": {
      "type": "string",
      "default": "none"
    },
    "layout": {
      "type": "string",
      "default": "layout-1"
    },
    "layout1AdvancedStyle": {
      "type": "string",
      "default": "layout-1-style-1"
    },
    "layout2AdvancedStyle": {
